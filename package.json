{
  "name": "prime-radiant-nomogenesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "wasm:build": "bash scripts/build-wasm.sh",
    "sandbox:primary": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/smoke.cjs",
    "sandbox:backup": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/backup.cjs",
    "test:sandbox": "npm run wasm:build && npm run sandbox:primary && npm run sandbox:backup && npm run sandbox:funding && npm run sandbox:settlement && npm run sandbox:withdrawal && npm run sandbox:failure && npm run sandbox:storage && npm run sandbox:storage-admission && npm run sandbox:capital && npm run sandbox:refund && npm run sandbox:ownership",
    "sandbox:funding": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/funding.cjs",
    "sandbox:settlement": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/settlement.cjs",
    "sandbox:withdrawal": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/withdrawal.cjs",
    "sandbox:failure": "bash scripts/test-withdrawal-failure.sh",
    "sandbox:storage": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/storage_audit.cjs",
    "sandbox:storage-admission": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/storage_admission.cjs",
    "sandbox:capital": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/capital_audit.cjs",
    "sandbox:refund": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/refund_integration.cjs",
    "sandbox:ownership": "NOMOGENESIS_WASM=$PWD/target/nomogenesis_compatible.wasm node sandbox/refund_ownership_audit.cjs",
    "sandbox:ownership-orders": "bash scripts/test-refund-orders.sh"
  },
  "devDependencies": {
    "binaryen": "132.0.0",
    "near-workspaces": "5.0.0"
  }
}
